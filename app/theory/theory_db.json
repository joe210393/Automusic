  "cadences": {
    "authentic": {
      "degrees": [
        "V",
        "I"
      ],
      "note": "正格終止：最強的收尾感，歌曲結尾一律使用"
    },
    "plagal": {
      "degrees": [
        "IV",
        "I"
      ],
      "note": "變格終止（阿們終止）：柔和的收尾，可用於段落中間"
    },
    "half": {
      "degrees": [
        "I",
        "V"
      ],
      "note": "半終止：停在 V 有懸念，用於段落中間製造期待"
    }
  },
  "melody_rules": {
    "strong_beat_chord_tone_prob": 0.85,
    "stepwise_preference": "旋律以級進（相鄰音）為主，跳進不超過三成",
    "max_leap_scale_steps": 4,
    "leap_resolution": "大跳（超過 2 個音階音）之後，下一個音要反向級進，聽起來才自然",
    "phrase_end_stable_tones": [
      0,
      4,
      7
    ],
    "final_note": "整段旋律的最後一個音落在主音，並拉長時值",
    "climax": "全曲最高音只出現一次，安排在中後段（黃金分割附近）最有張力",
    "note": "strong_beat_chord_tone_prob：強拍上落在當小節和弦內音的機率；phrase_end_stable_tones：樂句結尾允許的音（相對主音的半音數：主音/三音/五音）"
  },
  "voice_leading": {
    "max_movement_semitones": 5,
    "note": "和聲聲部移動越小越平滑；共同音保留，其他聲部就近移動"
  },
  "arrangement_rules": {
    "bass": "低音以和弦根音為主，強拍必為根音，弱拍可加五音",
    "harmony": "和聲聲部彈和弦內音，避免和主旋律同音域打架",
    "drums": "大鼓踩 1、3 拍，小鼓在 2、4 拍（backbeat），段落結尾可加過門",
    "dynamics": "強拍力度略大於弱拍，段落開頭比結尾有力"
  },
  "llm_prompt_rules": [
    "優先從這些經典進行中挑選或變化：I-V-vi-IV（流行）、I-vi-IV-V（50年代）、vi-IV-I-V（抒情）、I-IV-V-I（民謠）、ii-V-I（爵士收尾）",
    "相鄰兩小節盡量共用至少一個音（共同音），聽起來才連貫",
    "旋律強拍的音應該是當小節和弦的內音（根音、三音、五音）",
    "倒數第二小節用 V、最後一小節用 I（正格終止），收尾才有句點感",
    "小調感覺的旋律優先使用 vi 開頭的進行"
  ]
}
