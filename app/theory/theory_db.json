{
  "description": "Automusic 樂理資料庫：作曲引擎在生成音樂前會先讀取這裡的規則。可以直接編輯這個檔案來調整作曲風格，不需要改程式。",
  "progressions": [
    {
      "name": "流行四和弦（Axis）",
      "degrees": [
        "I",
        "V",
        "vi",
        "IV"
      ],
      "moods": [
        "bright",
        "warm",
        "energetic"
      ],
      "weight": 5,
      "note": "近代流行歌最常見的進行，明亮、朗朗上口（Let It Be、多數流行金曲）"
    },
    {
      "name": "50 年代進行（Doo-wop）",
      "degrees": [
        "I",
        "vi",
        "IV",
        "V"
      ],
      "moods": [
        "warm",
        "bright",
        "calm"
      ],
      "weight": 4,
      "note": "溫暖復古，適合抒情與兒歌（Stand by Me）"
    },
    {
      "name": "卡農進行",
      "degrees": [
        "I",
        "V",
        "vi",
        "iii",
        "IV",
        "I",
        "IV",
        "V"
      ],
      "moods": [
        "warm",
        "calm",
        "emotional"
      ],
      "weight": 4,
      "note": "Pachelbel 卡農，優雅流動，8 小節一循環"
    },
    {
      "name": "抒情小調進行",
      "degrees": [
        "vi",
        "IV",
        "I",
        "V"
      ],
      "moods": [
        "sad",
        "emotional",
        "energetic"
      ],
      "weight": 5,
      "note": "以關係小調開頭，憂鬱但有推進力，適合小調感覺的素材"
    },
    {
      "name": "民謠進行",
      "degrees": [
        "I",
        "IV",
        "V",
        "I"
      ],
      "moods": [
        "bright",
        "simple",
        "calm"
      ],
      "weight": 3,
      "note": "最基本的 I-IV-V，穩定樸實，適合童謠"
    },
    {
      "name": "溫柔進行",
      "degrees": [
        "I",
        "IV",
        "vi",
        "V"
      ],
      "moods": [
        "warm",
        "calm"
      ],
      "weight": 3,
      "note": "柔和，第三小節的 vi 帶一點感性"
    },
    {
      "name": "上行推進",
      "degrees": [
        "I",
        "iii",
        "IV",
        "V"
      ],
      "moods": [
        "bright",
        "energetic"
      ],
      "weight": 2,
      "note": "根音逐步上行，越來越亮，適合能量高的素材"
    },
    {
      "name": "爵士二五一",
      "degrees": [
        "ii",
        "V",
        "I",
        "I"
      ],
      "moods": [
        "calm",
        "jazzy"
      ],
      "weight": 2,
      "note": "ii-V-I 是最有解決感的進行，收尾特別穩"
    },
    {
      "name": "小調敘事",
      "degrees": [
        "vi",
        "IV",
        "vi",
        "V"
      ],
      "moods": [
        "sad",
        "emotional"
      ],
      "weight": 3,
      "note": "停留在小調色彩，說故事的感覺"
    },
    {
      "name": "搖滾動力",
      "degrees": [
        "I",
        "IV",
        "V",
        "IV"
      ],
      "moods": [
        "rock",
        "energetic"
      ],
      "weight": 3,
      "note": "I-IV-V 循環不回主和弦，持續推進不停歇，搖滾常用"
    },
    {
      "name": "循環圈",
      "degrees": [
        "vi",
        "ii",
        "V",
        "I"
      ],
      "moods": [
        "jazzy",
        "calm"
      ],
      "weight": 3,
      "note": "五度循環 vi-ii-V-I，爵士標準曲的骨架，優雅有方向感"
    },
    {
      "name": "搖籃曲進行",
      "degrees": [
        "I",
        "IV",
        "I",
        "V"
      ],
      "moods": [
        "lullaby",
        "calm",
        "simple"
      ],
      "weight": 3,
      "note": "只在 I、IV、V 之間輕輕擺盪，安穩無起伏，適合哄睡"
    }
  ],
